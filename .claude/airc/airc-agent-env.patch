+def _derived_identity(endpoint: str) -> str | None:
+    """With AIRC_E2E_IDENTITY=derive and the workspace key in $AIRC_KEY, derive this endpoint's identity
+    key from the workspace key instead of generating one, so a machine that keeps no files (a cloud
+    sandbox, a CI job) presents the same identity every session and peers' pins (§19.9) keep holding.
+    The trade: whoever holds the workspace key can also act as this endpoint's e2e identity. The realm
+    operator never sees either key, so what it can read is unchanged."""
+    if os.environ.get("AIRC_E2E_IDENTITY") != "derive" or not os.environ.get("AIRC_KEY"):
+        return None
+    seed = base64.b64decode(os.environ["AIRC_KEY"].strip())
+    okm = hmac.new(seed, b"airc e2e identity v1\x00" + endpoint.encode(), hashlib.sha256).digest()
+    return b64(okm)
+
+
