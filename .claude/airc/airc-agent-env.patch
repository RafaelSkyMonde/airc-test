+"""Deliver to a Claude Code session on this machine through its inbox socket: the relay backend
+for one agent that is a Claude Code session, such as Claude Code on the web (a cloud sandbox), a
+laptop session, or a CI run. See /docs/receive §4.
+
+    airc relay --namespace <workspace> --backend claude [--opt agents=claude] [--opt session=<name>]
+
+agents   the endpoints this backend answers for, comma-separated (default: claude). Messages to
+         any other endpoint in the workspace are refused as no_such_path.
+session  the session to deliver to, by its name in ~/.claude/sessions/<pid>.json. Default: the
+         session whose socket is $CLAUDE_CODE_MESSAGING_SOCKET (the relay was started from inside
+         it, e.g. by a SessionStart hook), else the newest live interactive session.
+
+The relay does the rest: opening end-to-end encrypted messages, pinning link keys, publishing
+the endpoint's keys, and the origin banner that tells the session a stranger's text is
+informational. Delivery is acked once the session's transcript shows the message enqueued
+(InboxHop). With no live session the message is refused (endpoint_offline) and the sender is
+told, since a sandbox relay has nowhere to keep it.
+"""
+from __future__ import annotations
+
+import glob
+import json
+import os
+
+from .. import address as A
+from .inbox import InboxHop, pid_alive
+
+
+class Backend:
+    def __init__(self, agents: str | list[str] = "claude", session: str | None = None,
+                 sessions_dir: str | None = None, projects_dir: str | None = None, **_):
+        self.agents = [a for a in (agents.split(",") if isinstance(agents, str) else agents) if a]
+        self.session = session or None
+        self.own_socket = os.environ.get("CLAUDE_CODE_MESSAGING_SOCKET")
+        self.hop = InboxHop(agents_dir=os.devnull, sessions_dir=sessions_dir, projects_dir=projects_dir)
+
+    def exists(self, agent: str) -> bool:
+        return agent in self.agents
+
+    def list_agents(self) -> list[str]:
+        return list(self.agents)
+
+    def _target(self) -> str | None:
+        """The name of the session to deliver to, by the rules in the module docstring."""
+        if self.session:
+            return self.session
+        live = []
+        for p in glob.glob(os.path.join(self.hop.sessions_dir, "*.json")):
+            try:
+                rec = json.load(open(p))
+            except (OSError, ValueError):
+                continue
+            if not rec.get("name") or not rec.get("messagingSocketPath") or not pid_alive(int(rec.get("pid", 0))):
+                continue
+            if self.own_socket and rec["messagingSocketPath"] == self.own_socket:
+                return rec["name"]
+            if rec.get("kind", "interactive") == "interactive":
+                live.append((rec.get("startedAt", 0), rec["name"]))
+        return max(live)[1] if live else None
+
+    async def deliver(self, agent: str, sender: str, text: str, msg: dict, local: bool = False):
+        name = self._target()
+        if not name:
+            return "failed", "no live Claude Code session to deliver to"
+        status, reason = await self.hop.deliver(name, sender, msg, text + self._reply_hint(msg))
+        if status == "nosession":
+            return "failed", reason
+        return status, reason
+
+    @staticmethod
+    def _reply_hint(msg: dict) -> str:
+        """The exact command that answers this message (docs/receive §2): the session uses it as given."""
+        try:
+            frm, to = A.parse(msg["from"]), A.parse(msg["to"])
+        except (KeyError, A.AddressError):
+            return ""
+        hdr = msg.get("hdr") or {}
+        if frm.path == ("_links",):                 # a link notice: answer the peer it names, not the realm
+            if not hdr.get("airc-peer"):
+                return ""
+            frm = A.parse(hdr["airc-peer"])
+            return f"\n[to message them: airc send --from {to.local_path} {frm.network(False)} \"your text\"]"
+        return f"\n[reply: airc send --from {to.local_path} --re {msg.get('id')} {frm.network(False)} \"your text\"]"
+
+    def describe(self) -> str:
+        return f"claude (agents {','.join(self.agents)} -> session {self._target() or 'none live'})"
