+def _listen_format(args) -> str:
+    return args.format or ("json" if args.json else "text")
+
+
+def _render_listen(m: dict, args, realm: str) -> str:
+    fmt = _listen_format(args)
+    if fmt == "json":
+        return json.dumps(m, ensure_ascii=False)
+    if fmt == "text":
+        return f"[from {m['from']}] {m['body']}"
+    # agent: what the relay's inbox backend hands a session (docs/receive §2), for a listener whose
+    # stdout an agent reads directly, e.g. Claude Code's Monitor tool. The block ends with a "---" line.
+    from .backends.inbox import InboxHop
+    from .relay import BANNER
+    frm, to = A.parse(m["from"]), A.parse(m["to"])
+    lines = []
+    if frm.path and frm.path[0] == "_links":
+        pass                                         # the realm's own notices: no banner, no reply
+    elif frm.realm != to.realm or (frm.path[:1] != to.path[:1]):
+        scope = f"realm {frm.realm}" if frm.realm != to.realm else f"another workspace on {frm.realm}"
+        lines.append(BANNER.format(sender=frm.network(False), scope=scope))
+    lines.append(InboxHop.header(frm.network(False), m))
+    lines.append(str(m.get("body") or ""))
+    if not (frm.path and frm.path[0] == "_links"):
+        server = "" if os.environ.get("AIRC_SERVER") == args.server else f" --server {args.server}"
+        lines.append(f"[reply: airc{server} send --from {to.local_path} --re {m.get('id')} "
+                     f"//{frm.realm}/{'/'.join(frm.path)} \"your text\"]")
+    lines.append("---")
+    return "\n".join(lines)
+
