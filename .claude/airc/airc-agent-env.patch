+def _key_from_env(realm: str, value: str) -> str:
+    """$AIRC_KEY holds a workspace key's contents (the base64 seed in a .key file), for machines that
+    keep no files between sessions: cloud sandboxes, CI. Written once to a hidden 0600 file that the
+    one-key lookup above does not see, so it never competes with keys on disk."""
+    import base64, binascii
+    try:
+        seed = base64.b64decode(value.strip(), validate=True)
+    except (binascii.Error, ValueError):
+        seed = b""
+    if len(seed) != 32:
+        raise SystemExit("airc: $AIRC_KEY is not a workspace key (expected the base64 line from a .key file)")
+    path = os.path.expanduser(f"~/.airc/{realm}/.env.key")
+    if not os.path.exists(path):
+        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+        with os.fdopen(fd, "w") as f:
+            f.write(value.strip() + "\n")
+    return path
+
